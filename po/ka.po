#: src/ypbinderr_string.c:42 src/yperr_string.c:40
msgid "Success"
msgstr "წარმატება"

#: src/ypbinderr_string.c:45
msgid "Internal ypbind error"
msgstr "Ypbind-ის შიდა შეცდომა"

#: src/ypbinderr_string.c:48
msgid "Domain not bound"
msgstr "დომენი ვერ ვიპოვე"

#: src/ypbinderr_string.c:51
msgid "System resource allocation failure"
msgstr "სისტემური რესურსის გამოყოფის შეცდომა"

#: src/ypbinderr_string.c:54
msgid "Domain doesn't exist"
msgstr "დომენი არ არსებობს"

#: src/ypbinderr_string.c:57
msgid "Unknown ypbind error"
msgstr "Ypbind-ის უცნობი შეცდომა"

#: src/yperr_string.c:43
msgid "Request arguments bad"
msgstr "მოთხოვნის არასწორი არგუმენტები"

#: src/yperr_string.c:46
msgid "RPC failure on NIS operation"
msgstr "RPC-ის ჩავარდნა NIS-ის ოპერაციაზე"

#: src/yperr_string.c:49
msgid "Can't bind to server which serves this domain"
msgstr "ვერ მივუერთდი სერვერის, რომელიც ამ დომენს ემსახურება"

#: src/yperr_string.c:52
msgid "No such map in server's domain"
msgstr "სერვერის დომენში ასეთი რუკა არ არსებობს"

#: src/yperr_string.c:55
msgid "No such key in map"
msgstr "რუკაში ასეთი გასაღები არ არსებობს"

#: src/yperr_string.c:58
msgid "Internal NIS error"
msgstr "NIS-ის შიდა შეცდომა"

#: src/yperr_string.c:61
msgid "Local resource allocation failure"
msgstr "ლოკალური რესურსის გამოყოფის შეცდომა"

#: src/yperr_string.c:64
msgid "No more records in map database"
msgstr "რუკის მონაცემთა ბაზაში მეტი ჩანაწერი არაა"

#: src/yperr_string.c:67
msgid "Can't communicate with portmapper"
msgstr "portmapper-თან კომუნიკაციის შეცდომა"

#: src/yperr_string.c:70
msgid "Can't communicate with ypbind"
msgstr "ypbind-თან კომუნიკაციის შეცდომა"

#: src/yperr_string.c:73
msgid "Can't communicate with ypserv"
msgstr "ypserv-თან კომუნიკაციის შეცდომა"

#: src/yperr_string.c:76
msgid "Local domain name not set"
msgstr "ლოკალური დომენის სახელი დაყენებული არაა"

#: src/yperr_string.c:79
msgid "NIS map database is bad"
msgstr "NIS -ის რუკის ბაზა დაზიანებულია"

#: src/yperr_string.c:82
msgid "NIS client/server version mismatch - can't supply service"
msgstr "NIS-ის კლიენტის/სერვერის ვერსია არ ემთხვევა - სერვისის მიწოდება შეუძლებელია"

#: src/yperr_string.c:85
msgid "Permission denied"
msgstr "წვდომა აკრძალულია"

#: src/yperr_string.c:88
msgid "Database is busy"
msgstr "მონაცემთა ბაზა დაკავებულია"

#: src/yperr_string.c:91
msgid "Unknown NIS error code"
msgstr "NIS-ის უცნობი შეცდომის კოდი"
